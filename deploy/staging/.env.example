# Exemplo sem segredos. Copiar para .env apenas no servidor de testes.
# Usar valores independentes, longos e aleatórios; não usar credenciais reais.
STAGING_DB_PASSWORD=
STAGING_DB_ROOT_PASSWORD=
STAGING_TLS_PASSWORD=
# Caminho absoluto no servidor para um PKCS12 de teste, legível pelo UID 10001.
STAGING_TLS_KEYSTORE=
